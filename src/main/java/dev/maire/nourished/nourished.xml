        public boolean isEdited() {
            return true;
        }

        @Override
        public void save() {
            // Module values are saved by each entry's save consumer.
        }

        @Override
        public Object getValue() {
            return Boolean.FALSE;
        }

        @Override
        public Optional<Object> getDefaultValue() {
            return Optional.empty();
        }

